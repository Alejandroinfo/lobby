rules_version = '2';

// Reglas de seguridad del lobby.
// Se publican copiándolas en la consola de Firebase (Firestore Database → Reglas → Publicar)
// o con: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function nombreValido(n) {
      return n is string && n.size() >= 1 && n.size() <= 24;
    }

    // Avatar: un emoji corto y un color #RRGGBB.
    function avatarValido(a) {
      return a is map && a.keys().hasOnly(['emoji', 'color'])
        && a.emoji is string && a.emoji.size() >= 1 && a.emoji.size() <= 16
        && a.color is string && a.color.matches('^#[0-9a-fA-F]{6}$');
    }

    // Dueño del lobby: solo esta cuenta de Google (verificada) puede leer el panel de playtest.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'alejandro.armasb@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Panel de playtest: lectura de todas las partidas, resultados y encuestas (consultas de grupo).
    match /{ruta=**}/partidas/{id} {
      allow read: if esAdmin();
    }
    match /{ruta=**}/resultados/{quien} {
      allow read: if esAdmin();
    }
    match /{ruta=**}/encuestas/{quien} {
      allow read: if esAdmin();
    }
    match /{ruta=**}/marcas/{quien} {
      allow read: if esAdmin();
    }

    // Perfil de cada jugador: solo lo lee y lo cambia su dueño. Además del nombre, guarda de forma
    // opcional y por rangos datos de audiencia (país de 2 letras, edad, cómo llegó, experiencia).
    match /jugadores/{uid} {
      function perfilValido(d) {
        return d.keys().hasOnly(['nombre', 'ultimaVez', 'pais', 'rangoEdad', 'comoLlego', 'experiencia', 'salaOrigen', 'carrera', 'avatar', 'fichaVisible', 'tipoJugador'])
          && (!('fichaVisible' in d) || d.fichaVisible is bool)
          && (!('tipoJugador' in d) || d.tipoJugador in ['estratega', 'social', 'competitivo', 'casual', 'no-dice'])
          && (!('avatar' in d) || avatarValido(d.avatar))
          && (!('nombre' in d) || nombreValido(d.nombre))
          && (!('pais' in d) || (d.pais is string && d.pais.matches('^[A-Z]{2}$')))
          && (!('rangoEdad' in d) || d.rangoEdad in ['menos-13', '13-17', '18-24', '25-34', '35-44', '45-mas', 'no-dice'])
          && (!('comoLlego' in d) || d.comoLlego in ['amigo', 'convencion', 'redes', 'otro', 'no-dice'])
          && (!('experiencia' in d) || d.experiencia in ['casual', 'frecuente', 'muy-frecuente', 'no-dice'])
          && (!('salaOrigen' in d) || (d.salaOrigen is string && d.salaOrigen.size() <= 8))
          && (!('carrera' in d) || (d.carrera is map && d.carrera.keys().hasOnly(['partidas', 'victorias', 'retos', 'logros'])));
      }
      allow read: if (autenticado() && request.auth.uid == uid) || esAdmin();
      allow delete: if autenticado() && request.auth.uid == uid;
      allow create, update: if autenticado() && request.auth.uid == uid && perfilValido(request.resource.data);

      // Historial personal: una entrada por partida o reto terminado. Solo lo ve y lo escribe su dueño.
      match /historial/{id} {
        allow read: if (autenticado() && request.auth.uid == uid) || esAdmin();
        allow delete: if autenticado() && request.auth.uid == uid;
        allow create: if autenticado() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['tipo', 'juego', 'sala', 'fecha', 'gano', 'empate', 'puntaje', 'variante', 'jugadores', 'diario'])
          && request.resource.data.tipo in ['partida', 'reto']
          && request.resource.data.juego is string && request.resource.data.juego.size() <= 40
          && request.resource.data.sala is string && request.resource.data.sala.size() <= 8
          && request.resource.data.gano is bool
          && request.resource.data.empate is bool
          && (request.resource.data.puntaje == null || request.resource.data.puntaje is number)
          && request.resource.data.jugadores is list && request.resource.data.jugadores.size() <= 12
          && request.resource.data.fecha == request.time;
        allow update: if false;
      }
    }

    // Ficha que ven los demás (rango, avatar, condecoraciones). Solo se lee si su dueño la hizo
    // visible; la escribe y la borra solo su dueño.
    match /perfiles/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || resource.data.visible == true);
      allow delete: if autenticado() && request.auth.uid == uid;
      allow create, update: if autenticado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['visible', 'nombre', 'avatar', 'partidas', 'victorias', 'retos', 'logros'])
        && request.resource.data.visible is bool
        && (!('nombre' in request.resource.data) || nombreValido(request.resource.data.nombre))
        && (!('avatar' in request.resource.data) || avatarValido(request.resource.data.avatar))
        && (!('logros' in request.resource.data) || request.resource.data.logros is map);
    }

    // Reto del día: una marca por persona y por día, igual para todas las salas. Cualquiera con
    // sesión las lee (ranking global; cada sala filtra a sus miembros). Se escribe una vez y no se cambia.
    match /retosDiarios/{fecha}/marcas/{quien} {
      allow read: if autenticado();
      allow create: if autenticado()
        && quien == request.auth.uid
        && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['nombre', 'puntaje', 'version', 'detalleJson', 'hora', 'sala'])
        && nombreValido(request.resource.data.nombre)
        && request.resource.data.puntaje is number
        && request.resource.data.puntaje >= 0 && request.resource.data.puntaje <= 1000
        && request.resource.data.detalleJson is string
        && request.resource.data.detalleJson.size() <= 200000
        && (!('sala' in request.resource.data) || (request.resource.data.sala is string && request.resource.data.sala.size() <= 8))
        && request.resource.data.hora == request.time;
      allow delete: if autenticado() && quien == request.auth.uid; // «Borrar mis datos»
      allow update: if false;
    }

    // Una sala por grupo. Cualquiera con sesión puede leerla (el código hace de invitación),
    // pero cada miembro solo toca su propia entrada; el anfitrión puede cambiar el resto.
    match /salas/{codigo} {

      function miembroValido(m) {
        return m.keys().hasOnly(['nombre', 'entrada', 'ultimaVez', 'avatar']) && nombreValido(m.nombre)
          && (!('avatar' in m) || avatarValido(m.avatar));
      }

      function soloMiEntrada() {
        let yo = request.auth.uid;
        let cambios = request.resource.data.diff(resource.data).affectedKeys();
        let entradas = request.resource.data.miembros.diff(resource.data.miembros).affectedKeys();
        return cambios.hasOnly(['miembros'])
          && entradas.hasOnly([yo])
          && (!(yo in request.resource.data.miembros) || miembroValido(request.resource.data.miembros[yo]));
      }

      function soyAnfitrion() {
        return request.auth.uid == resource.data.anfitrion
          && request.resource.data.anfitrion == resource.data.anfitrion
          && request.resource.data.codigo == resource.data.codigo
          && request.resource.data.creada == resource.data.creada;
      }

      function esMiembro() {
        return request.auth.uid in get(/databases/$(database)/documents/salas/$(codigo)).data.miembros;
      }

      allow read: if autenticado();

      allow create: if autenticado()
        && codigo.matches('^[A-HJ-NP-Z2-9]{5}$')
        && request.resource.data.keys().hasOnly(['codigo', 'nombre', 'anfitrion', 'miembros', 'creada'])
        && request.resource.data.codigo == codigo
        && request.resource.data.anfitrion == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 40
        && request.resource.data.miembros.keys().hasOnly([request.auth.uid])
        && miembroValido(request.resource.data.miembros[request.auth.uid]);

      allow update: if autenticado() && (soloMiEntrada() || soyAnfitrion());
      allow delete: if false;

      // Chat de la sala: solo los miembros leen y escriben; nadie edita ni borra.
      match /mensajes/{id} {
        allow read: if autenticado() && esMiembro();
        allow create: if autenticado() && esMiembro()
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'texto', 'hora'])
          && request.resource.data.uid == request.auth.uid
          && nombreValido(request.resource.data.nombre)
          && request.resource.data.texto is string
          && request.resource.data.texto.size() >= 1
          && request.resource.data.texto.size() <= 500
          && request.resource.data.hora == request.time;
        allow update, delete: if false;
      }

      // Retos en solitario con semilla. Cualquier miembro puede crear uno; nadie lo cambia ni lo borra.
      // (El reto del día no tiene documento: solo existen sus marcas, en retos/diario-AAAA-MM-DD/marcas.)
      match /retos/{reto} {
        allow read: if autenticado() && esMiembro();
        allow create: if autenticado() && esMiembro()
          && request.resource.data.keys().hasOnly(['juego', 'tipo', 'semilla', 'variante', 'dificultad', 'creador', 'creadorNombre', 'creado'])
          && request.resource.data.tipo == 'directo'
          && request.resource.data.juego in ['split-loyalty']
          && request.resource.data.semilla is string
          && request.resource.data.semilla.matches('^[A-Z0-9]{4,12}$')
          && request.resource.data.variante is string && request.resource.data.variante.size() <= 20
          && request.resource.data.dificultad in ['hard', 'easy']
          && request.resource.data.creador == request.auth.uid
          && nombreValido(request.resource.data.creadorNombre)
          && request.resource.data.creado == request.time;
        allow update, delete: if false;

        // Primer intento de cada persona. Se escribe una vez y no se cambia.
        match /marcas/{quien} {
          allow read: if autenticado() && esMiembro();
          allow create: if autenticado() && esMiembro()
            && quien == request.auth.uid
            && exists(/databases/$(database)/documents/salas/$(codigo)/retos/$(reto))
            && request.resource.data.keys().hasOnly(['nombre', 'puntaje', 'version', 'detalleJson', 'hora'])
            && nombreValido(request.resource.data.nombre)
            && request.resource.data.puntaje is number
            && request.resource.data.puntaje >= 0 && request.resource.data.puntaje <= 1000
            && request.resource.data.detalleJson is string
            && request.resource.data.detalleJson.size() <= 200000
            && request.resource.data.hora == request.time;
          allow update, delete: if false;
        }
      }

      // Partidas de la sala. Cualquier miembro puede crear una; quien la crea la controla
      // (lanzar, quitar invitados, terminar). Cada invitado solo cambia su propia respuesta.
      match /partidas/{id} {

        function invitadoValido(i) {
          return i.keys().hasOnly(['nombre', 'rol', 'respuesta', 'listo', 'respondio', 'asiento', 'equipo'])
            && nombreValido(i.nombre)
            && i.rol in ['jugador', 'espectador']
            && i.respuesta in ['pendiente', 'acepta', 'rechaza']
            && i.listo is bool;
        }

        function cambioDelCreador() {
          return request.auth.uid == resource.data.anfitrion
            && request.resource.data.anfitrion == resource.data.anfitrion
            && request.resource.data.juego == resource.data.juego
            && request.resource.data.creada == resource.data.creada
            && request.resource.data.estado in ['invitando', 'jugando', 'terminada', 'cancelada'];
        }

        function miRespuesta() {
          let yo = request.auth.uid;
          let antes = resource.data.invitados;
          let despues = request.resource.data.invitados;
          return resource.data.estado == 'invitando'
            && yo in antes
            && yo in despues
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitados'])
            && despues.diff(antes).affectedKeys().hasOnly([yo])
            && despues[yo].diff(antes[yo]).affectedKeys().hasOnly(['respuesta', 'rol', 'listo', 'respondio'])
            && invitadoValido(despues[yo]);
        }

        // Si quien organiza lleva más de 100 s sin dar señales (cerró el lobby), un jugador que
        // aceptó puede quedarse con el control. Solo cambia `anfitrion`, y solo hacia sí mismo.
        function tomoElControl() {
          let yo = request.auth.uid;
          let creador = resource.data.anfitrion;
          let miembros = get(/databases/$(database)/documents/salas/$(codigo)).data.miembros;
          return resource.data.estado in ['invitando', 'jugando']
            && yo in resource.data.invitados
            && resource.data.invitados[yo].respuesta == 'acepta'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anfitrion'])
            && request.resource.data.anfitrion == yo
            && (!(creador in miembros)
                || miembros[creador].ultimaVez < request.time - duration.value(100, 's'));
        }

        // Un jugador que recibió el resultado del juego da la partida por terminada (solo si
        // ya guardó su resultado). Solo cambia estado, hora de término y resumen.
        function terminoConResultado() {
          let yo = request.auth.uid;
          return resource.data.estado == 'jugando'
            && yo in resource.data.invitados
            && resource.data.invitados[yo].respuesta == 'acepta'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'terminada', 'resultado'])
            && request.resource.data.estado == 'terminada'
            && exists(/databases/$(database)/documents/salas/$(codigo)/partidas/$(id)/resultados/$(yo));
        }

        allow read: if autenticado() && esMiembro();

        allow create: if autenticado() && esMiembro()
          && request.resource.data.keys().hasOnly(['juego', 'variante', 'anfitrion', 'estado', 'invitados',
                                                   'codigoJuego', 'creada', 'iniciada', 'terminada'])
          && request.resource.data.anfitrion == request.auth.uid
          && request.resource.data.estado == 'invitando'
          && request.resource.data.juego in ['split-loyalty', 'astrolabe', 'blindspot', 'bst-animals']
          && request.auth.uid in request.resource.data.invitados
          && request.resource.data.invitados.size() <= 12
          && request.resource.data.creada == request.time;

        allow update: if autenticado() && esMiembro()
          && (cambioDelCreador() || miRespuesta() || tomoElControl() || terminoConResultado());
        allow delete: if false;

        // Encuesta de playtest de cada persona que participó. Se escribe una vez y no se cambia.
        match /encuestas/{quien} {
          function nota(v) {
            return v == null || (v is int && v >= 1 && v <= 5);
          }
          allow read: if autenticado() && esMiembro();
          allow create: if autenticado() && esMiembro()
            && quien == request.auth.uid
            && get(/databases/$(database)/documents/salas/$(codigo)/partidas/$(id)).data.invitados[quien].respuesta == 'acepta'
            && request.resource.data.keys().hasOnly(['juego', 'diversion', 'claridad', 'duracion', 'comentario', 'extra', 'hora'])
            && nota(request.resource.data.diversion)
            && nota(request.resource.data.claridad)
            && (request.resource.data.duracion == null || request.resource.data.duracion in ['corta', 'justa', 'larga'])
            && request.resource.data.comentario is string
            && request.resource.data.comentario.size() <= 1000
            && request.resource.data.extra is map
            && request.resource.data.extra.size() <= 4
            && request.resource.data.hora == request.time;
          allow update, delete: if false;
        }

        // Resultado que informó el juego a cada jugador. Se escribe una vez y no se cambia.
        match /resultados/{quien} {
          allow read: if autenticado() && esMiembro();
          allow create: if autenticado() && esMiembro()
            && quien == request.auth.uid
            && get(/databases/$(database)/documents/salas/$(codigo)/partidas/$(id)).data.invitados[quien].respuesta == 'acepta'
            && request.resource.data.keys().hasOnly(['asiento', 'ganadores', 'puntajes', 'duracionSeg', 'version',
                                                     'detalleJson', 'recibido'])
            && request.resource.data.ganadores is list
            && request.resource.data.detalleJson is string
            && request.resource.data.detalleJson.size() <= 200000
            && request.resource.data.recibido == request.time;
          allow update, delete: if false;
        }
      }
    }
  }
}
