{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/juegos/split-loyalty/:ruta*",
      "destination": "https://split-loyalty.vercel.app/app/:ruta*"
    },
    {
      "source": "/juegos/astrolabe/:ruta*",
      "destination": "https://astrolabebg.vercel.app/:ruta*"
    },
    {
      "source": "/((?!api/|juegos/).*)",
      "destination": "/index.html"
    }
  ]
}
