{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/juegos/split-loyalty/:ruta*",
      "destination": "https://split-loyalty.vercel.app/app/:ruta*"
    },
    {
      "source": "/juegos/astrolabe/:ruta*",
      "destination": "https://astrolabebg.vercel.app/:ruta*"
    },
    {
      "source": "/juegos/double-cross/",
      "destination": "https://split-loyalty-double-cross.vercel.app/"
    },
    {
      "source": "/juegos/double-cross",
      "destination": "https://split-loyalty-double-cross.vercel.app/"
    },
    {
      "source": "/juegos/double-cross/:ruta*",
      "destination": "https://split-loyalty-double-cross.vercel.app/:ruta*"
    },
    {
      "source": "/((?!api/|juegos/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/chat-juego.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
